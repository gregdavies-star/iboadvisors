{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "https://iboadvisors-dashboard.vercel.app/dashboard"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://iboadvisors-dashboard.vercel.app/dashboard/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "iboadvisors.com"
        }
      ],
      "destination": "https://www.iboadvisors.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "iboadvisors.com"
        }
      ],
      "destination": "https://www.iboadvisors.com/:path*",
      "permanent": true
    },
    {
      "source": "/meet",
      "destination": "/?learn-more=1",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/independent-buyout-ibo",
      "destination": "/blog/independent-buyout-explained",
      "permanent": true
    },
    {
      "source": "/blog/what-is-an-independent-buyout",
      "destination": "/blog/independent-buyout-explained",
      "permanent": true
    },
    {
      "source": "/blog/independent-buyout-vs-private-equity",
      "destination": "/blog/ibo-vs-pe-numbers-comparison",
      "permanent": true
    },
    {
      "source": "/blog/what-happens-after-a-private-equity-buyout",
      "destination": "/blog/what-happens-after-private-equity-buys-your-company",
      "permanent": true
    },
    {
      "source": "/industries",
      "destination": "/ebitda-multiples-by-industry",
      "permanent": true
    }
  ]
}
